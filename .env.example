# MingliGo MCP (neutral build/runtime defaults)
MINGLIGO_HTTP_LISTEN_ADDRESS=:8081

# Comma-separated browser origins allowed by CORS. Leave empty for local or
# server-to-server use; browser origins must be configured explicitly.
MINGLIGO_ALLOWED_ORIGINS=

# Runtime MCP identity. Hosted deployment injects its own identity; local and
# CI keep the neutral identity below.
MINGLIGO_SERVER_NAME=local/mingligo-mcp
MINGLIGO_SERVER_TITLE=MingliGo MCP
MINGLIGO_SERVER_URL=https://github.com/ml8s

# Successful tool results are structured-only and omit duplicate TextContent.
