# MingliGo MCP MCP (neutral build/runtime defaults)
LIKI_HTTP_LISTEN_ADDRESS=:8081

# Comma-separated browser origins allowed by CORS. Leave empty for the hosted
# default. Self-hosted web clients should set their exact HTTPS origin.
LIKI_ENGINE_ALLOWED_ORIGINS=

# Runtime MCP identity. Hosted deployment injects hk.liki/engine; local and CI
# keep the neutral identity below.
MINGLI_SERVER_NAME=local/mingligo-mcp
MINGLI_SERVER_TITLE=MingliGo MCP
MINGLI_SERVER_URL=https://github.com/ml8s

# Successful tool results: "structured" omits duplicate TextContent.
